# ==============================================================================
# ACRONE COLLECTION — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env for local development or configure these variables
# directly in the Vercel Project Settings > Environment Variables dashboard.
# Never commit real production secrets to version control.
# ==============================================================================

# Node Environment ('production' in Vercel, 'development' locally)
NODE_ENV=development

# Server-to-Server Bot Authentication Secret (HMAC-SHA256)
# Must match the secret configured in Streamer.bot / Acrone Points desktop app.
BOT_API_SECRET=your_super_secret_high_entropy_bot_api_key_here_change_in_production

# Turso Cloud / libSQL Database (Required in Production on Vercel)
# Obtain these from your Turso dashboard or the Vercel Turso integration
TURSO_DATABASE_URL=libsql://your-database-name-your-org.turso.io
TURSO_AUTH_TOKEN=your_turso_database_auth_token_here

# Local SQLite Database Path (Used for local development when TURSO_DATABASE_URL is unset)
DB_PATH=./data/acrone_collection.db

# Canonical Base URL for generated public profile links
SITE_BASE_URL=https://your-acrone-project.vercel.app

# Search Engine Indexing (Default: false to prevent indexing viewer profiles)
ALLOW_SEARCH_INDEXING=false

# Allowed Cross-Origin Origins (comma-separated or * for open client consumption)
CORS_ORIGINS=*
