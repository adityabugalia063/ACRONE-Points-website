# ==============================================================================
# ACRONE COLLECTION — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and customize for your deployment environment.
# Never commit real production secrets to version control.
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV=production

# Server-to-Server Bot Authentication Secret
# Must match the secret configured in Streamer.bot / Acrone Points desktop app.
BOT_API_SECRET=your_super_secret_high_entropy_bot_api_key_here_change_in_production

# Durable Database Storage Path
# Defaults to server/data/acrone_collection.db
DB_PATH=./server/data/acrone_collection.db

# Canonical Base URL for generated public profile links
SITE_BASE_URL=https://collection.acrone.gg

# Search Engine Indexing (Default: false to prevent indexing private viewer profiles)
ALLOW_SEARCH_INDEXING=false

# Allowed Cross-Origin Origins (comma-separated or * for public APIs)
CORS_ORIGINS=*
